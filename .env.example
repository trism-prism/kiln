# Public build-time settings, read by Vite. These are baked into the shipped JavaScript and visible
# to everyone: never put a secret here. Copy to `.env.local` (git-ignored) for local use.

# Address of the Kiln Worker for reminders, sync and the daily ping. Include https://, no trailing slash.
# Empty: those features are switched off (the app works offline-first without them).
# (VITE_SYNC_URL was the old name and is still read for one release.)
VITE_API_URL=

# VAPID public key (base64url) printed by `npm run vapid` in worker/. The same key is in worker/wrangler.toml.
# The private key is a Worker secret and never goes here. Empty: reminders are switched off.
VITE_VAPID_PUBLIC_KEY=
