{
  "name": "kiln",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:worker": "npm --prefix worker run typecheck && npm --prefix worker test",
    "schema": "node scripts/write-schema.ts",
    "templates": "node scripts/write-templates.ts",
    "neetcode": "node scripts/write-neetcode.ts",
    "licenses": "node scripts/write-licenses.ts",
    "icons": "pwa-assets-generator --config scripts/pwa-assets.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@noble/curves": "2.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "ts-fsrs": "6.0.0",
    "vite-plugin-pwa": "2.0.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1"
  }
}
